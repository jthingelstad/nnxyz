{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "nnxyz GitHub OIDC read-only builds and main-only publication",
  "Parameters": {
    "ArchiveBucket": {
      "Type": "String",
      "AllowedPattern": "[a-zA-Z0-9.-]+"
    },
    "SiteBucket": {
      "Type": "String",
      "AllowedPattern": "[a-zA-Z0-9.-]+"
    },
    "DistributionId": {
      "Type": "String",
      "AllowedPattern": "[a-zA-Z0-9.-]+"
    }
  },
  "Resources": {
    "BuildRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:oidc-provider/token.actions.githubusercontent.com"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": [
                    "repo:jthingelstad@5351/nnxyz@1417597840:ref:refs/heads/main",
                    "repo:jthingelstad@5351/nnxyz@1417597840:pull_request"
                  ]
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "GalleryDelivery",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": ["s3:GetObject"],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${ArchiveBucket}/datasets/*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "DeploymentRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:oidc-provider/token.actions.githubusercontent.com"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": "repo:jthingelstad@5351/nnxyz@1417597840:ref:refs/heads/main"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "GalleryDelivery",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${SiteBucket}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": ["s3:GetObject", "s3:PutObject"],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${SiteBucket}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudfront:CreateInvalidation",
                    "cloudfront:GetInvalidation",
                    "cloudfront:GetDistribution"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${DistributionId}"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "BuildRoleArn": {
      "Value": {
        "Fn::GetAtt": ["BuildRole", "Arn"]
      },
      "Description": "BuildRole GitHub OIDC identity"
    },
    "DeploymentRoleArn": {
      "Value": {
        "Fn::GetAtt": ["DeploymentRole", "Arn"]
      },
      "Description": "DeploymentRole GitHub OIDC identity"
    }
  }
}
