---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import RoomEntrance from '../../components/RoomEntrance.astro';
import { entrances, roomWorks, entranceWork } from '../../lib/exhibitions';
import { abstractImage } from '../../lib/abstract';
import { displayTitle } from '../../lib/catalog';
export function getStaticPaths() {
  return entrances.map((entrance) => ({
    params: { collection: entrance.id },
    props: { entrance },
  }));
}
const { entrance } = Astro.props;
const combined = entrance.wings.length > 1;
const cover = entranceWork(entrance);
const shareImage =
  'inkId' in cover ? `/png/${cover.inkId}.png` : abstractImage(cover, 1200);
const description = entrance.wings[0].introduction[0];
---

<Layout
  title={`${entrance.title} — nnxyz`}
  description={description}
  image={shareImage}
>
  <article class="museum-page collection-wing">
    <a class="museum-back" href="/#collections">
      <Icon name="left" size={18} />
      Back to collections
    </a>
    <h1>{entrance.title}</h1>
    {combined && (
      <p class="wing-introduction">
        Other nnxyz drawings and a related collection by Scrimshaw, each with
        its own rooms.
      </p>
    )}
    {entrance.wings.map((wing) => (
      <section class="wing-group" id={wing.id} aria-label={wing.title}>
        {combined && <h2>{wing.title}</h2>}
        <div class="wing-text">
          {wing.introduction.map((paragraph) => (
            <p class="wing-introduction">{paragraph}</p>
          ))}
        </div>
        {wing.parts.length ? (
          wing.parts.map((part, i) => (
            <section class="wing-part" id={part.key} aria-label={part.title}>
              <p class="exhibition-meta">
                Part {i + 1} of {wing.parts.length} · {part.dates}
              </p>
              <h2>{part.title}</h2>
              <div class="wing-text">
                {part.introduction.map((paragraph) => (
                  <p class="wing-introduction">{paragraph}</p>
                ))}
              </div>
              <div class="exhibition-choices">
                {part.rooms.map((room) => (
                  <RoomEntrance room={room} />
                ))}
              </div>
            </section>
          ))
        ) : (
          <div class="exhibition-choices">
            {wing.rooms.map((room) => (
              <RoomEntrance room={room} />
            ))}
          </div>
        )}
        <p class="exhibition-meta wing-count">
          {wing.rooms.reduce((n, room) => n + roomWorks(room).length, 0)} works
          in {wing.rooms.length} {wing.rooms.length === 1 ? 'room' : 'rooms'}
          {wing.endsOn && `, ending on ${displayTitle({ name: wing.endsOn })}`}.
        </p>
      </section>
    ))}
  </article>
</Layout>
