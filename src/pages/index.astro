---
import Layout from '../layouts/Layout.astro';
import DrawingViewer from '../components/DrawingViewer.astro';
import {
  byId,
  artworkPath,
  displayTitle,
  thumbnail,
  collectionPath,
} from '../lib/catalog';
import { entrances, representative } from '../lib/exhibitions';
const opening = byId.get('QmRgmiafSLrdXUocj4Twi7geisrrvZcsTxV27nymo6vurJ')!;
---

<Layout image={`/png/${opening.inkId}.png`}>
  <div class="museum-page entrance-page">
    <section class="museum-entrance" aria-label="Welcome to the collection">
      <div class="welcome-space">
        <h1>
          A collection
          <br /> of nnxyz
        </h1>
        <p class="welcome-pending">A welcome from the collector will follow.</p>
      </div>
      <div class="entrance-drawing">
        <DrawingViewer work={opening} autoplay />
        <p class="opening-caption">
          <a href={artworkPath(opening.inkId)}>{displayTitle(opening)}</a>
        </p>
      </div>
    </section>
    <nav
      class="collection-entrances"
      id="collections"
      aria-label="Explore collections"
    >
      {entrances.map((entrance) => {
        const work = representative(entrance.gallery);
        return (
          <a class="collection-entrance" href={collectionPath(entrance.id)}>
            <img
              {...thumbnail(work)}
              sizes="(max-width: 760px) 45vw, (max-width: 1200px) 27vw, 365px"
              alt={`${displayTitle(work)} by ${work.artistName}`}
              width={work.width}
              height={work.height}
              loading="lazy"
            />
            <h2>{entrance.title}</h2>
          </a>
        );
      })}
    </nav>
  </div>
</Layout>
