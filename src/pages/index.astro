---
import Layout from '../layouts/Layout.astro';
import DrawingViewer from '../components/DrawingViewer.astro';
import statement from '../../curation/collector-statement.json';
import {
  byId,
  artworkPath,
  displayTitle,
  thumbnail,
  collectionPath,
} from '../lib/catalog';
import { entrances, entranceWork } from '../lib/exhibitions';
const opening = byId.get('QmRgmiafSLrdXUocj4Twi7geisrrvZcsTxV27nymo6vurJ')!;
// The statement is the collector's own words, saved verbatim; its one Markdown
// link is rendered and everything else is escaped.
const escape = (text: string) =>
  text
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;');
const paragraphHtml = (text: string) =>
  text
    .split(/(\[[^\]]+\]\(https?:\/\/[^)\s]+\))/)
    .map((piece) => {
      const link = piece.match(/^\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)$/);
      return link
        ? `<a href="${escape(link[2])}">${escape(link[1])}</a>`
        : escape(piece);
    })
    .join('');
---

<Layout image={`/png/${opening.inkId}.png`}>
  <div class="museum-page entrance-page">
    <section class="museum-entrance" aria-label="Welcome to the collection">
      <div class="welcome-space">
        <h1>
          A collection
          <br /> of nnxyz
        </h1>
        <div class="collector-statement">
          {statement.paragraphs.map((paragraph) => (
            <p set:html={paragraphHtml(paragraph)} />
          ))}
          <p class="collector-signature">
            {statement.signature}
            <span>{statement.dateline}</span>
          </p>
        </div>
      </div>
      <div class="entrance-drawing">
        <DrawingViewer work={opening} autoplay />
        <p class="opening-caption">
          <a href={artworkPath(opening.inkId)}>{displayTitle(opening)}</a>
        </p>
      </div>
    </section>
    <nav
      class="collection-entrances"
      id="collections"
      aria-label="Explore collections"
    >
      {entrances.map((entrance) => {
        const work = entranceWork(entrance);
        const count = entrance.wings.reduce((n, w) => n + w.rooms.length, 0);
        return (
          <a class="collection-entrance" href={collectionPath(entrance.id)}>
            <img
              {...thumbnail(work)}
              sizes="(max-width: 760px) 45vw, (max-width: 1200px) 27vw, 365px"
              alt={`${displayTitle(work)} by ${work.artistName}`}
              width={work.width}
              height={work.height}
              loading="lazy"
            />
            <h2>{entrance.title}</h2>
            <span>
              {count} {count === 1 ? 'room' : 'rooms'}
            </span>
          </a>
        );
      })}
    </nav>
    <p class="entrance-map-link">
      <a href="/map/">See the map of the collection</a>
      <a href="/screensaver/">Screen saver</a>
      <a href="/notes/">Notes from the curator</a>
    </p>
  </div>
</Layout>
