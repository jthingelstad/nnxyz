---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Kudos from '../../components/Kudos.astro';
import {
  artworks,
  artworkPath,
  collectionPath,
  collectionTitle,
  displayTitle,
  labels,
  byId,
  thumbnailPath,
} from '../../lib/catalog';
export function getStaticPaths() {
  return artworks.map((work) => ({
    params: { id: work.inkId },
    props: { work },
  }));
}
const { work } = Astro.props;
const label = labels.get(work.inkId)!;
const title = displayTitle(work);
const neighbors = label.collectionContext.numberedOwnedNeighbors;
const previous = neighbors?.previous;
const next = neighbors?.next;
const backLabel =
  work.collectionId === 'nifty-faces'
    ? 'Faces'
    : collectionTitle(work.collectionId);
const reading = label.curatorialReading.text;
---

<Layout
  title={`${title} — nnxyz`}
  image={`/png/${work.inkId}.png`}
  description={reading}
>
  <a class="back-link" href={collectionPath(work.collectionId)}>
    <Icon name="left" size={20} /> Back to {backLabel}
  </a>
  <div class="work-page">
    <div
      class="work-viewer"
      data-viewer
      data-src={`/art/${work.inkId}.svg`}
      data-id={work.inkId}
    >
      <div
        class="art-stage"
        style={`aspect-ratio:${work.width}/${work.height}`}
      >
        <img
          class="finished-art"
          src={`/art/${work.inkId}.svg`}
          alt={`${title} by ${work.artistName}`}
          width={work.width}
          height={work.height}
          fetchpriority="high"
        />
        <div class="drawing-art" aria-hidden="true"></div>
      </div>
      <div class="player" aria-label="Drawing playback">
        <button
          class="play-button"
          data-play
          aria-pressed="false"
          data-tinylytics-event="drawing.play"
          data-tinylytics-event-value={work.inkId}
        >
          <span data-play-icon>
            <Icon name="play" size={30} />
          </span>
          <span data-play-label>Watch drawing</span>
        </button>
        <input
          class="scrubber"
          data-seek
          type="range"
          min="0"
          max="1000"
          step="1"
          value="1000"
          aria-label="Drawing progress"
          aria-valuetext="Complete drawing"
        />
        <select data-speed aria-label="Playback speed">
          <option value="0.5">½×</option>
          <option value="1" selected>
            1×
          </option>
          <option value="2">2×</option>
          <option value="4">4×</option>
        </select>
        <button class="reset-button" data-reset aria-label="Reset drawing">
          <Icon name="reset" size={24} />
        </button>
      </div>
      <p data-player-status class="player-status" role="status"></p>
    </div>
    <div class="work-content">
      <div class="work-caption">
        <div>
          <h1>{title}</h1>
          <p class="byline">
            {work.artistName} · {work.strokes.toLocaleString('en-US')} recorded
            strokes
          </p>
        </div>
        <div class="work-actions">
          <Kudos path={artworkPath(work.inkId)} title={title} />
          <a
            class="download-link"
            href={`/art/${work.inkId}.svg`}
            download={`${title}.svg`}
            data-tinylytics-event="file.download"
            data-tinylytics-event-value={work.inkId}
          >
            Download SVG
          </a>
          <button
            data-enlarge
            data-tinylytics-event="artwork.enlarge"
            data-tinylytics-event-value={work.inkId}
          >
            <Icon name="enlarge" size={22} />
            <span>Enlarge</span>
          </button>
        </div>
      </div>
      <section class="curator-reading" aria-label="AI curator interpretation">
        <h2>AI curator</h2>
        <p>{reading}</p>
      </section>
      <p class="collection-position">
        {previous && next
          ? `Between ${displayTitle(byId.get(previous.inkId)!)} and ${displayTitle(byId.get(next.inkId)!)} in the owned title sequence.`
          : label.collectionContext.text}
      </p>
      <nav class="work-navigation" aria-label="Artwork navigation">
        {previous ? (
          <a href={artworkPath(previous.inkId)}>
            <Icon name="left" size={20} /> Previous
            <span class="mobile-neighbor">
              {' '}
              ({displayTitle(byId.get(previous.inkId)!).replace(/^Nifty /, '')})
            </span>
          </a>
        ) : (
          <span></span>
        )}
        {next && (
          <a href={artworkPath(next.inkId)}>
            Next
            <span class="mobile-neighbor">
              {' '}
              ({displayTitle(byId.get(next.inkId)!).replace(/^Nifty /, '')})
            </span>
            <Icon name="right" size={20} />
          </a>
        )}
        {label.connections.length > 0 && (
          <a class="related-anchor" href="#related">
            Related works
          </a>
        )}
        <button class="details-trigger" data-details>
          Details &amp; provenance
        </button>
      </nav>
      <details class="provenance" id="provenance">
        <summary>Details &amp; provenance</summary>
        <p>
          Playback follows recorded paths and order. Timing is reconstructed;
          the archive does not record the artist’s speed or pauses.
        </p>
        <dl>
          {label.technical.map((fact) => (
            <>
              <dt>{fact.label}</dt>
              <dd>
                {typeof fact.value === 'object'
                  ? `${fact.value.width} × ${fact.value.height}`
                  : fact.value}
              </dd>
            </>
          ))}
        </dl>
        <dl>
          <dt>Drawing CID</dt>
          <dd class="identifier">{work.inkId}</dd>
          <dt>Creator address</dt>
          <dd class="identifier">{work.artist}</dd>
        </dl>
        <p class="record-links">
          <a href={`/records/${work.inkId}.metadata.json`} download>
            Archived metadata
          </a>
          <a href={`/records/${work.inkId}.provenance.json`} download>
            Ownership &amp; provenance
          </a>
          <a href={`/png/${work.inkId}.png`} download>
            Original PNG
          </a>
          <a href={`/art/${work.inkId}.svg`} download={`${title}.svg`}>
            Native SVG
          </a>
        </p>
        <p>{label.interpretationNotice}</p>
      </details>
      {label.connections.length > 0 && (
        <section
          id="related"
          class="related-works"
          aria-label="Related artworks"
        >
          <h2>Related works</h2>
          {label.connections.map((connection) => {
            const related = byId.get(connection.targetArtworkId)!;
            return (
              <a
                class="related-work"
                href={artworkPath(related.inkId)}
                data-tinylytics-event="curation.follow"
                data-tinylytics-event-value={related.inkId}
              >
                <img
                  src={thumbnailPath(related)}
                  alt={displayTitle(related)}
                  width="140"
                  height="140"
                  loading="lazy"
                />
                <div>
                  <h3>{displayTitle(related)}</h3>
                  <p>{connection.reason}</p>
                  <span>Follow this connection →</span>
                </div>
              </a>
            );
          })}
        </section>
      )}
    </div>
  </div>
  <dialog class="enlargement" data-enlargement aria-label={`Enlarged ${title}`}>
    <button data-close-enlargement aria-label="Close enlarged artwork">
      <Icon name="close" />
    </button>
    <div class="enlargement-art">
      <img src={`/art/${work.inkId}.svg`} alt={title} />
    </div>
  </dialog>
  <script>
    import { initViewer } from '../../scripts/viewer';
    initViewer();
  </script>
</Layout>
