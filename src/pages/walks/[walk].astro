---
import Layout from '../../layouts/Layout.astro';
import { routes, byId, artworkPath, displayTitle } from '../../lib/catalog';
export function getStaticPaths() {
  return routes.map((route) => ({
    params: { walk: route.id },
    props: { route },
  }));
}
const { route } = Astro.props;
---

<Layout title={`${route.title} — nnxyz`}>
  <article class="walk-page">
    <a href="/walks/">← Curated walks</a>
    <h1>{route.title}</h1>
    <p>{route.basis}</p>
    <p class="small-note">AI curator · {route.scope}</p>
    <div class="walk-stops">
      {route.stops.map((stop, index) => {
        const work = byId.get(stop.artworkId)!;
        return (
          <section>
            <a href={artworkPath(work.inkId)}>
              <img
                src={`/art/${work.inkId}.svg`}
                alt={displayTitle(work)}
                width={work.width}
                height={work.height}
                loading={index ? 'lazy' : 'eager'}
              />
              <h2>{displayTitle(work)}</h2>
            </a>
            <p>{stop.reason}</p>
          </section>
        );
      })}
    </div>
  </article>
</Layout>
