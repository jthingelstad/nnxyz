---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { saverWorks } from '../../lib/screensaver';
const total = saverWorks().length;
---

<Layout
  title="Screen saver — The nnxyz Rooms"
  description="One work at a time from the collection, drawn stroke by stroke and held, with its title and caption."
>
  <section class="saver" data-saver data-source="/screensaver/data.json">
    <div class="saver-stage" data-stage aria-live="off">
      <div class="saver-layer" data-layer="a"></div>
      <div class="saver-layer" data-layer="b"></div>
    </div>
    <div class="saver-overlay" data-overlay hidden>
      <div class="saver-panel">
        <p class="saver-context" data-context></p>
        <h1 class="saver-title">
          <a data-title-link href="/"></a>
        </h1>
        <p class="saver-caption" data-caption></p>
      </div>
    </div>
    <div class="saver-controls" data-controls>
      <button type="button" data-saver-toggle aria-label="Pause">
        <span class="when-playing">
          <Icon name="pause" size={20} /> Pause
        </span>
        <span class="when-paused">
          <Icon name="play" size={20} /> Play
        </span>
      </button>
      <button type="button" data-saver-previous aria-label="Previous work">
        <Icon name="left" size={20} /> Previous
      </button>
      <button type="button" data-saver-next aria-label="Next work">
        Next <Icon name="right" size={20} />
      </button>
      <button type="button" data-saver-fullscreen aria-label="Fullscreen">
        <Icon name="enlarge" size={20} /> Fullscreen
      </button>
      <label class="saver-setting">
        <span>Drawing speed</span>
        <select data-saver-speed aria-label="Drawing speed">
          <option value="0.5">½×</option>
          <option value="1" selected>
            1×
          </option>
          <option value="2">2×</option>
          <option value="4">4×</option>
        </select>
      </label>
      <label class="saver-setting">
        <span>Hold</span>
        <select data-saver-hold aria-label="Hold on each finished work">
          <option value="5">5 s</option>
          <option value="10" selected>
            10 s
          </option>
          <option value="20">20 s</option>
          <option value="60">1 min</option>
        </select>
      </label>
      <span class="saver-note" data-note>
        Loading {total} works…
      </span>
    </div>
    <noscript>
      <p class="saver-noscript">
        The screen saver needs JavaScript. The works themselves are in the
        <a href="/#collections">collections</a>.
      </p>
    </noscript>
  </section>
  <script>
    import { initScreensaver } from '../../scripts/screensaver';
    initScreensaver();
  </script>
</Layout>
