---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
interface Props {
  title?: string;
  image?: string;
  description?: string;
}
const {
  title = 'The nnxyz Rooms',
  image,
  description = 'A collection of nnxyz artwork hung in twenty-eight rooms, with a related collection by Scrimshaw. Faces, New Nifty on the Block, Rawblocks, Abstract, and Other & related.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const analytics =
  import.meta.env.PROD && import.meta.env.PUBLIC_TINYLYTICS_ENABLED === 'true';
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Read before the first paint so navigation preserves the chosen backdrop.
      try {
        if (localStorage.getItem('nnxyz-theme') === 'dark')
          document.documentElement.dataset.theme = 'dark';
      } catch {
        /* White remains the default when storage is unavailable. */
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The nnxyz Rooms" />
    <meta property="og:url" content={canonical} />
    {image && (
      <meta property="og:image" content={new URL(image, Astro.site).href} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#000000"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body data-analytics-enabled={String(analytics)}>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="The nnxyz Rooms, home">
        The nnxyz Rooms
      </a>
      <nav aria-label="Main navigation">
        <a href="/#collections">Collections</a>
        <a href="/story/">Story</a>
        <a href="/map/">Map</a>
        <a href="/search/" class="search-link">
          <span class="search-icon">
            <Icon name="search" size={17} />
          </span>
          <span class="search-label">Search</span>
        </a>
        <a href="/about/" class="about-link">
          About
        </a>
        <button
          class="theme-toggle"
          data-theme-toggle
          aria-label="Use dark background"
          hidden
        >
          <span class="moon-icon">
            <Icon name="moon" size={17} />
          </span>
          <span class="sun-icon">
            <Icon name="sun" size={17} />
          </span>
          <span data-theme-label>Dark</span>
        </button>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <div id="kudos-notice" role="status" class="notice" hidden>
      Kudos will be available on the published gallery.
    </div>
    {analytics && <script is:inline>
      if (location.hostname === 'nnxyz.thingelstad.xyz') {
        const script = document.createElement('script');
        script.src =
          'https://tinylytics.app/embed/7MaUUztU7BVzhcxntCUh.js?kudos=custom&events';
        script.defer = true;
        document.body.append(script);
      }
    </script>}
    <script>
      const themeToggle = document.querySelector<HTMLButtonElement>(
        '[data-theme-toggle]',
      )!;
      function showTheme(theme: 'light' | 'dark') {
        document.documentElement.dataset.theme = theme;
        themeToggle.setAttribute(
          'aria-label',
          `Use ${theme === 'dark' ? 'light' : 'dark'} background`,
        );
        themeToggle.querySelector('[data-theme-label]')!.textContent =
          theme === 'dark' ? 'Light' : 'Dark';
      }
      showTheme(
        document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light',
      );
      themeToggle.hidden = false;
      themeToggle.addEventListener('click', () => {
        const theme =
          document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        showTheme(theme);
        try {
          localStorage.setItem('nnxyz-theme', theme);
        } catch {
          /* Switching still works for this page. */
        }
      });
      window.addEventListener('storage', (event) => {
        if (event.key === 'nnxyz-theme' || event.key === null)
          showTheme(event.newValue === 'dark' ? 'dark' : 'light');
      });
      const live =
        document.body.dataset.analyticsEnabled === 'true' &&
        location.hostname === 'nnxyz.thingelstad.xyz';
      if (!live) {
        let hideNotice: ReturnType<typeof setTimeout>;
        document
          .querySelectorAll<HTMLButtonElement>('.kudos')
          .forEach((button) => {
            button.addEventListener('click', () => {
              const notice =
                document.querySelector<HTMLElement>('#kudos-notice')!;
              notice.hidden = false;
              clearTimeout(hideNotice);
              hideNotice = setTimeout(() => {
                notice.hidden = true;
              }, 3000);
            });
          });
      }
    </script>
  </body>
</html>
