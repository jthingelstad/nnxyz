---
interface Props {
  work?: string;
  room?: string;
  from?: string;
}
const { work, room, from = 'map' } = Astro.props;
const hash = new URLSearchParams(work ? { work } : room ? { room } : { from });
---

<a class="virtual-visit-link" data-pagefind-ignore href={'/visit/#' + hash}>
  <slot />
  <span aria-hidden="true">↗</span>
</a>

<style>
  .virtual-visit-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    font:
      500 0.92rem/1.4 'Helvetica Neue',
      Arial,
      sans-serif;
    text-decoration: underline;
    text-underline-offset: 0.23em;
    color: inherit;
    margin: 0.55rem 0;
  }
  .virtual-visit-link span {
    font-size: 0.9em;
  }
</style>
