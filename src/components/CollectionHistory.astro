---
import history from '../../curation/collection-history.json';
interface Props {
  collectionId: string;
}
const record = history.collections.find(
  (item) => item.collectionId === Astro.props.collectionId,
);
---

{record && (
  <div class="collection-history">
    <p>{record.text}</p>
    <p class="small-note">
      Collector’s earlier account ·{' '}
      <a href={record.sourceUrl}>Read the earlier gallery</a>
    </p>
  </div>
)}
