---
import { displayTitle, artworkPath, thumbnailPath } from '../lib/catalog';
import { exhibitionArtwork, type ExhibitionStop } from '../lib/exhibitions';
interface Props {
  stop: ExhibitionStop;
  eager?: boolean;
}
const { stop, eager = false } = Astro.props;
const work = exhibitionArtwork(stop.artworkId);
const id = stop.artworkId;
const drawing = 'inkId' in work;
---

<figure class="exhibition-work" id={`work-${id}`} tabindex="-1">
  <a
    class="exhibition-art"
    href={artworkPath(id)}
    aria-label={`${drawing ? 'View and watch' : 'View'} ${displayTitle(work)} by ${work.artistName}`}
  >
    <img
      src={thumbnailPath(work)}
      alt={`${displayTitle(work)} by ${work.artistName}`}
      width={work.width}
      height={work.height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </a>
  <figcaption>
    <h3>
      <a href={artworkPath(id)}>{displayTitle(work)}</a>
    </h3>
    <p class="exhibition-artist">{work.artistName}</p>
    <a class="watch-work" href={artworkPath(id)}>
      {drawing ? 'View & watch drawing' : 'View artwork'}
    </a>
    <div class="exhibition-note">
      <p>{stop.whyHere}</p>
    </div>
  </figcaption>
</figure>
