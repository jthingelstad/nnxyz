---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import Kudos from './Kudos.astro';
import DrawingViewer from './DrawingViewer.astro';
import ProvenanceNote from './ProvenanceNote.astro';
import { ownedTokens } from '../lib/provenance';
import { placement, roomWorks, exhibitionPath } from '../lib/exhibitions';
import { formatUtcDateTime, formatUtcDate } from '../lib/dates';
import { workFacts } from '../lib/story';
import BuildSequence from './BuildSequence.astro';
import { techniqueById, measures, techniquePath } from '../lib/technique';
import {
  artworks,
  artworkPath,
  displayTitle,
  labels,
  byId,
} from '../lib/catalog';
interface Props {
  work: (typeof artworks)[number];
}
const { work } = Astro.props;
const label = labels.get(work.inkId)!;
const title = displayTitle(work);
const place = placement(work.inkId);
const home = place.room;
const sequence = roomWorks(home);
const position = place.index;
// A related item hangs after the room; its neighbors are the room's last work.
const previous =
  position === null ? sequence[sequence.length - 1] : sequence[position - 1];
const next = position === null ? undefined : sequence[position + 1];
const numbered = label.collectionContext.numberedOwnedNeighbors;
const reading = place.work.reading;
const recordedAt = place.work.facts.recordedAt;
// The archived label converts the creation time to US Central; the site shows
// the archived instant in UTC and lets the browser add the viewer's local time.
const technical = label.technical.filter(
  (fact) => fact.id !== 'recorded-creation',
);
const tokens = ownedTokens(work.inkId);
// The story facts: the artist's own post about the drawing, and the day and
// way it reached the collector (curation/story/facts.json).
const facts = workFacts.get(work.inkId);
const post = facts?.post;
const collected = facts?.collected;
// Twelve works carry their build at five points in the stroke order (/technique/).
const technique = techniqueById.get(work.inkId);
const strokeMeasures = technique ? measures.get(work.inkId) : undefined;
---

<Layout
  title={`${title} — The nnxyz Rooms`}
  image={`/png/${work.inkId}.png`}
  description={reading}
>
  <a class="back-link" href={`${exhibitionPath(home.id)}#work-${work.inkId}`}>
    <Icon name="left" size={20} /> Back to {home.title}
  </a>
  <div class="work-page">
    <DrawingViewer work={work} />
    <div class="work-content">
      <div class="work-caption">
        <div>
          <h1>{title}</h1>
          {work.artistName !== 'nnxyz' && (
            <p class="byline">{work.artistName}</p>
          )}
          <ProvenanceNote tokens={tokens} />
        </div>
        <div class="work-actions">
          <Kudos path={artworkPath(work.inkId)} title={title} />
          <button
            data-enlarge
            data-tinylytics-event="artwork.enlarge"
            data-tinylytics-event-value={work.inkId}
          >
            <Icon name="enlarge" size={22} />
            <span>Enlarge</span>
          </button>
        </div>
      </div>
      <section class="curator-reading" aria-label="Label">
        <p>{reading}</p>
      </section>
      {post && (
        <section class="artist-post" aria-label="The artist’s post">
          <p>
            The artist <a href={post.url}>posted this drawing</a> on{' '}
            {formatUtcDate(post.postedAt)}
            {post.priceXDai !== null && <>, at {post.priceXDai} xDai</>}.
          </p>
          {post.remark && (
            <blockquote class="artist-remark">
              {post.remark.split('\n').map((line) => (
                <p>{line}</p>
              ))}
            </blockquote>
          )}
        </section>
      )}
      {technique && strokeMeasures && (
        <section class="artwork-build" aria-label="How it was built">
          <p>
            How it was built: {strokeMeasures.strokes} strokes at five points in
            their recorded order.{' '}
            <a href={`${techniquePath}#work-${technique.artworkId}`}>
              Read the technique page
            </a>
            .
          </p>
          <BuildSequence work={work} strokes={strokeMeasures.strokes} compact />
        </section>
      )}
      <p class="gallery-position">
        {position === null ? (
          <>
            Shown with <a href={exhibitionPath(home.id)}>{home.title}</a> as a
            related work from the Scrimshaw collection.
          </>
        ) : (
          <>
            Work {position + 1} of {sequence.length} in{' '}
            <a href={exhibitionPath(home.id)}>{home.title}</a>, {home.wingTitle}
            .
          </>
        )}
      </p>
      <nav class="work-navigation" aria-label="Artwork navigation">
        {previous ? (
          <a href={artworkPath(previous.artworkId)}>
            <Icon name="left" size={20} /> Previous
            <span class="mobile-neighbor">
              {' '}
              (
              {displayTitle(byId.get(previous.artworkId)!).replace(
                /^Nifty /,
                '',
              )}
              )
            </span>
          </a>
        ) : (
          <span></span>
        )}
        {next && (
          <a href={artworkPath(next.artworkId)}>
            Next
            <span class="mobile-neighbor">
              {' '}
              ({displayTitle(byId.get(next.artworkId)!).replace(/^Nifty /, '')})
            </span>
            <Icon name="right" size={20} />
          </a>
        )}
      </nav>
      <details
        class="provenance"
        id="provenance"
        aria-label="Artwork details and provenance"
      >
        <summary>Details &amp; downloads</summary>
        <div class="artwork-details-content">
          {numbered?.previous && numbered?.next && (
            <p class="collection-position">
              Between {displayTitle(byId.get(numbered.previous.inkId)!)} and{' '}
              {displayTitle(byId.get(numbered.next.inkId)!)} in the owned title
              sequence.
            </p>
          )}
          <p>
            Playback follows recorded paths and order. Timing is reconstructed;
            the archive does not record the artist’s speed or pauses.
          </p>
          <dl>
            {recordedAt && (
              <>
                <dt>Recorded</dt>
                <dd>
                  <time datetime={recordedAt} data-utc>
                    {formatUtcDateTime(recordedAt)}
                  </time>
                </dd>
              </>
            )}
            {collected && (
              <>
                <dt>Collected</dt>
                <dd>
                  {collected.how},{' '}
                  <time datetime={collected.on}>
                    {formatUtcDate(collected.on)}
                  </time>
                  {collected.wallet && <> ({collected.wallet})</>}.
                </dd>
              </>
            )}
            {technical.map((fact) => (
              <>
                <dt>{fact.label}</dt>
                <dd>
                  {typeof fact.value === 'object'
                    ? `${fact.value.width} × ${fact.value.height}`
                    : fact.value}
                </dd>
              </>
            ))}
          </dl>
          <p class="record-links">
            <a
              href={`/art/${work.inkId}.svg`}
              download={`${title}.svg`}
              data-tinylytics-event="file.download"
              data-tinylytics-event-value={work.inkId}
            >
              Download SVG
            </a>
            <a href={`/records/${work.inkId}.metadata.json`} download>
              Archived metadata
            </a>
            <a href={`/records/${work.inkId}.provenance.json`} download>
              Ownership &amp; provenance
            </a>
            <a href={`/png/${work.inkId}.png`} download>
              Original PNG
            </a>
          </p>
          <p>
            The label is a visual reading, not a claim about the artist’s
            intentions. Dates are UTC, from the archived creation timestamp.
          </p>
        </div>
      </details>
    </div>
  </div>
  <script>
    import { initSequences } from '../scripts/sequence';
    initSequences();
    // Add the viewer's local time beside the UTC instant. Without JavaScript the
    // UTC text stands alone.
    for (const time of document.querySelectorAll<HTMLTimeElement>(
      'time[data-utc]',
    )) {
      const instant = new Date(time.dateTime);
      if (Number.isNaN(instant.getTime())) continue;
      const local = new Intl.DateTimeFormat(undefined, {
        dateStyle: 'medium',
        timeStyle: 'short',
      }).format(instant);
      const zone =
        new Intl.DateTimeFormat(undefined, { timeZoneName: 'short' })
          .formatToParts(instant)
          .find((part) => part.type === 'timeZoneName')?.value ?? '';
      if (zone === 'UTC' || zone === 'GMT') continue;
      const note = document.createElement('span');
      note.className = 'local-time';
      note.textContent = ` (${local} ${zone}, your time)`;
      time.after(note);
    }
  </script>
  <dialog class="enlargement" data-enlargement aria-label={`Enlarged ${title}`}>
    <button data-close-enlargement aria-label="Close enlarged artwork">
      <Icon name="close" />
    </button>
    <div class="enlargement-art">
      <img src={`/art/${work.inkId}.svg`} alt={title} />
    </div>
  </dialog>
</Layout>
