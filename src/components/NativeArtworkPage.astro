---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import Kudos from './Kudos.astro';
import DrawingViewer from './DrawingViewer.astro';
import ProvenanceNote from './ProvenanceNote.astro';
import { readProvenance } from '../lib/provenance';
import {
  galleryHome,
  exhibitionStops,
  exhibitionPath,
} from '../lib/exhibitions';
import {
  artworks,
  artworkPath,
  displayTitle,
  labels,
  byId,
  thumbnail,
} from '../lib/catalog';
interface Props {
  work: (typeof artworks)[number];
}
const { work } = Astro.props;
const label = labels.get(work.inkId)!;
const title = displayTitle(work);
const home = galleryHome.get(work.inkId)!;
const sequence = exhibitionStops(home);
const position = sequence.findIndex((stop) => stop.artworkId === work.inkId);
const previous = sequence[position - 1];
const next = sequence[position + 1];
const numbered = label.collectionContext.numberedOwnedNeighbors;
const reading = label.curatorialReading.text;
const tokens = readProvenance(work.provenancePath);
---

<Layout
  title={`${title} — nnxyz`}
  image={`/png/${work.inkId}.png`}
  description={reading}
>
  <a class="back-link" href={`${exhibitionPath(home.id)}#work-${work.inkId}`}>
    <Icon name="left" size={20} /> Back to {home.title}
  </a>
  <div class="work-page">
    <DrawingViewer work={work} />
    <div class="work-content">
      <div class="work-caption">
        <div>
          <h1>{title}</h1>
          {work.artistName !== 'nnxyz' && (
            <p class="byline">{work.artistName}</p>
          )}
          <ProvenanceNote tokens={tokens} />
        </div>
        <div class="work-actions">
          <Kudos path={artworkPath(work.inkId)} title={title} />
          <button
            data-enlarge
            data-tinylytics-event="artwork.enlarge"
            data-tinylytics-event-value={work.inkId}
          >
            <Icon name="enlarge" size={22} />
            <span>Enlarge</span>
          </button>
        </div>
      </div>
      <section class="curator-reading" aria-label="AI curator interpretation">
        <h2>AI curator</h2>
        <p>{reading}</p>
      </section>
      <p class="gallery-position">
        Work {position + 1} of {sequence.length} in{' '}
        <a href={exhibitionPath(home.id)}>{home.title}</a>.
      </p>
      <nav class="work-navigation" aria-label="Artwork navigation">
        {previous ? (
          <a href={artworkPath(previous.artworkId)}>
            <Icon name="left" size={20} /> Previous
            <span class="mobile-neighbor">
              {' '}
              (
              {displayTitle(byId.get(previous.artworkId)!).replace(
                /^Nifty /,
                '',
              )}
              )
            </span>
          </a>
        ) : (
          <span></span>
        )}
        {next && (
          <a href={artworkPath(next.artworkId)}>
            Next
            <span class="mobile-neighbor">
              {' '}
              ({displayTitle(byId.get(next.artworkId)!).replace(/^Nifty /, '')})
            </span>
            <Icon name="right" size={20} />
          </a>
        )}
      </nav>
      <details
        class="provenance"
        id="provenance"
        aria-label="Artwork details and provenance"
      >
        <summary>Details &amp; downloads</summary>
        <div class="artwork-details-content">
          <p class="collection-position">
            {numbered?.previous && numbered?.next
              ? `Between ${displayTitle(byId.get(numbered.previous.inkId)!)} and ${displayTitle(byId.get(numbered.next.inkId)!)} in the owned title sequence.`
              : label.collectionContext.text}
          </p>
          <p>
            Playback follows recorded paths and order. Timing is reconstructed;
            the archive does not record the artist’s speed or pauses.
          </p>
          <dl>
            {label.technical.map((fact) => (
              <>
                <dt>{fact.label}</dt>
                <dd>
                  {typeof fact.value === 'object'
                    ? `${fact.value.width} × ${fact.value.height}`
                    : fact.value}
                </dd>
              </>
            ))}
          </dl>
          <p class="record-links">
            <a
              href={`/art/${work.inkId}.svg`}
              download={`${title}.svg`}
              data-tinylytics-event="file.download"
              data-tinylytics-event-value={work.inkId}
            >
              Download SVG
            </a>
            <a href={`/records/${work.inkId}.metadata.json`} download>
              Archived metadata
            </a>
            <a href={`/records/${work.inkId}.provenance.json`} download>
              Ownership &amp; provenance
            </a>
            <a href={`/png/${work.inkId}.png`} download>
              Original PNG
            </a>
          </p>
          <p>{label.interpretationNotice}</p>
        </div>
      </details>
      {label.connections.length > 0 && (
        <section
          id="related"
          class="related-works"
          aria-label="Related artworks"
        >
          <h2>Related works</h2>
          {label.connections.map((connection) => {
            const related = byId.get(connection.targetArtworkId)!;
            return (
              <a
                class="related-work"
                href={artworkPath(related.inkId)}
                data-tinylytics-event="curation.follow"
                data-tinylytics-event-value={related.inkId}
              >
                <img
                  {...thumbnail(related)}
                  sizes="140px"
                  alt={displayTitle(related)}
                  width="140"
                  height="140"
                  loading="lazy"
                />
                <div>
                  <h3>{displayTitle(related)}</h3>
                  <p>{connection.reason}</p>
                </div>
              </a>
            );
          })}
        </section>
      )}
    </div>
  </div>
  <dialog class="enlargement" data-enlargement aria-label={`Enlarged ${title}`}>
    <button data-close-enlargement aria-label="Close enlarged artwork">
      <Icon name="close" />
    </button>
    <div class="enlargement-art">
      <img src={`/art/${work.inkId}.svg`} alt={title} />
    </div>
  </dialog>
</Layout>
